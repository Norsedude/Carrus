# Copy to .env.local and fill in. Never commit real keys.
# For local development run `npm run db:start`, then `npx supabase status`
# and copy the API URL, publishable key and secret key printed there.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Server only. Bypasses row-level security; used by quote/booking services and seed scripts.
SUPABASE_SECRET_KEY=replace-with-secret-key

APP_BASE_URL=http://localhost:3000
# development | test | preview | production
APP_ENV=development
# simulated is the only implemented mode (no real money moves).
PAYMENT_MODE=simulated
# native = Carrus inventory only. native+demo = also show clearly labeled demo external sources.
PROVIDER_MODE=native

# Seed/reset scripts refuse to run unless the Supabase URL host is listed here.
TEST_DATABASE_ALLOWLIST=127.0.0.1,localhost
# Optional, development/test only: pin "now" for validation, e.g. 2026-12-01T18:00:00Z
# CARRUS_FIXED_NOW=
