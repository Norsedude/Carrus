# Copy to .env.local and fill in. Never commit real keys.
# For local development run `npm run db:start`, then `npx supabase status`
# and copy the API URL, publishable key and secret key printed there.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Server only. Bypasses row-level security; used by quote/booking services and seed scripts.
SUPABASE_SECRET_KEY=replace-with-secret-key

APP_BASE_URL=http://localhost:3000
# development | test | preview | production
APP_ENV=development
# In production the app requires both site-access secrets before it serves pages.
# Generate them with: node scripts/generate-site-access.mjs
# Set SITE_ACCESS_ENABLED=true to test the password gate locally.
# SITE_ACCESS_ENABLED=false
# SITE_ACCESS_PASSWORD_HASH=
# SITE_ACCESS_SESSION_SECRET=
# simulated is the only implemented mode (no real money moves).
PAYMENT_MODE=simulated
# native = Carrus inventory only. native+demo = add fictional external listings for testing the demo checkout.
PROVIDER_MODE=native
# true = add free open-data demo listings near any search: real models from the
# NHTSA vPIC database and freely licensed Wikimedia Commons photos (credited),
# with generated demo prices. No keys needed; no rental company is contacted.
PUBLIC_DEMO_LISTINGS=false

# Optional authorized partner feed(s), supplied by a partner or licensed aggregator.
# Keep tokens server-side. See docs/PARTNER_FEEDS.md for the response contract.
# PARTNER_FEEDS_JSON=[{"key":"example","name":"Example Rentals","url":"https://api.example.com/carrus/search","token":"replace-me","allowedHosts":["example.com"],"imageHosts":["images.example.com"]}]

# Seed/reset scripts refuse to run unless the Supabase URL host is listed here.
TEST_DATABASE_ALLOWLIST=127.0.0.1,localhost
# Optional, development/test only: pin "now" for validation, e.g. 2026-12-01T18:00:00Z
# CARRUS_FIXED_NOW=
